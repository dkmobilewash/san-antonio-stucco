{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.sanantoniostucco.com" }],
      "destination": "https://sanantoniostucco.com/:path",
      "permanent": true
    },
    { "source": "/stucco-repair", "destination": "/stucco-repairs", "permanent": true },
    { "source": "/stucco-repair-san-antonio", "destination": "/stucco-repairs/san-antonio", "permanent": true },
    { "source": "/stucco-installation-san-antonio", "destination": "/stucco-installation/san-antonio", "permanent": true },
    { "source": "/eifs-stucco-san-antonio", "destination": "/eifs-synthetic-stucco/san-antonio", "permanent": true },
    { "source": "/commercial-stucco-san-antonio", "destination": "/commercial-stucco/san-antonio", "permanent": true },
    { "source": "/stucco-contractor-san-antonio", "destination": "/", "permanent": true },
    { "source": "/residential-stucco-san-antonio", "destination": "/residential-stucco/san-antonio", "permanent": true },
    { "source": "/stucco-replacement-san-antonio", "destination": "/stucco-replacement/san-antonio", "permanent": true },
    { "source": "/stucco-painting-san-antonio", "destination": "/stucco-painting/san-antonio", "permanent": true },
    { "source": "/stucco-remodeling-san-antonio", "destination": "/stucco-remodeling/san-antonio", "permanent": true },
    { "source": "/stucco-installations", "destination": "/stucco-installation", "permanent": true },
    { "source": "/stucco-replacements", "destination": "/stucco-replacement", "permanent": true },
    { "source": "/stucco-contractors", "destination": "/", "permanent": true },
    { "source": "/stucco-san-antonio", "destination": "/san-antonio", "permanent": true },
    { "source": "/stucco-services", "destination": "/services", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
