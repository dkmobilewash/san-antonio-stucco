{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.sanantoniostucco.com" }],
      "destination": "https://sanantoniostucco.com/:path",
      "permanent": true
    },
    { "source": "/stucco-repair", "destination": "/stucco-repairs", "permanent": true },
    { "source": "/stucco-repair-san-antonio", "destination": "/stucco-repairs", "permanent": true },
    { "source": "/stucco-installation-san-antonio", "destination": "/stucco-installation", "permanent": true },
    { "source": "/eifs-stucco-san-antonio", "destination": "/eifs-synthetic-stucco", "permanent": true },
    { "source": "/commercial-stucco-san-antonio", "destination": "/commercial-stucco", "permanent": true },
    { "source": "/stucco-contractor-san-antonio", "destination": "/", "permanent": true },
    { "source": "/residential-stucco-san-antonio", "destination": "/residential-stucco", "permanent": true },
    { "source": "/stucco-replacement-san-antonio", "destination": "/stucco-replacement", "permanent": true },
    { "source": "/stucco-painting-san-antonio", "destination": "/stucco-painting", "permanent": true },
    { "source": "/stucco-remodeling-san-antonio", "destination": "/stucco-remodeling", "permanent": true },
    { "source": "/stucco-installations", "destination": "/stucco-installation", "permanent": true },
    { "source": "/stucco-replacements", "destination": "/stucco-replacement", "permanent": true },
    { "source": "/stucco-contractors", "destination": "/", "permanent": true },
    { "source": "/stucco-san-antonio", "destination": "/san-antonio", "permanent": true },
    { "source": "/stucco-services", "destination": "/services", "permanent": true },
    {
      "source": "/:service(stucco-repairs|stucco-installation|stucco-replacement|residential-stucco|commercial-stucco|eifs-synthetic-stucco|stucco-painting|stucco-remodeling)/san-antonio",
      "destination": "/:service",
      "permanent": true
    },
    {
      "source": "/:service(stucco-repairs|stucco-installation|stucco-replacement|residential-stucco|commercial-stucco|eifs-synthetic-stucco|stucco-painting|stucco-remodeling)/:location(boerne|new-braunfels|schertz|helotes|stone-oak|alamo-heights|live-oak|universal-city|leon-valley|selma)",
      "destination": "/:location",
      "permanent": true
    },
    {
      "source": "/blog/what-is-the-issue-with-stucco",
      "destination": "/blog/what-are-the-downsides-of-stucco",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
